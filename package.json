{
  "name": "pitch-pal",
  "version": "5.0.0",
  "description": "A handheld-game-style soccer player who lives on your desktop and whose form depends on your daily tasks.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pitchpal.app",
    "productName": "Pitch Pal",
    "files": [
      "main.js",
      "calendar.js",
      "preload.js",
      "core.js",
      "gb.js",
      "sfx.js",
      "reading.js",
      "news.js",
      "fonts/**",
      "index.html",
      "widget.html",
      "reminder.html",
      "assets/**",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": null
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "node-ical": "^0.20.1"
  }
}